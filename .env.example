# PostgreSQL (compose'dagi `db` servisi uchun)
POSTGRES_DB=mebel_catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog_password

# Backend
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://catalog:catalog_password@db:5432/mebel_catalog
CORS_ORIGINS=http://localhost:3000

# QR kodlar va havolalar shu manzilga ishora qiladi
PUBLIC_SITE_URL=http://localhost:3000

# @BotFather bergan token. Bo‘sh bo‘lsa bildirishnoma yuborilmaydi (buyurtma baribir saqlanadi).
TELEGRAM_BOT_TOKEN=

# `POST /api/super/businesses` uchun. Bo‘sh bo‘lsa endpoint hamma uchun yopiq.
SUPER_ADMIN_TOKEN=
